# ==============================================================================
# Environment Configuration for Pokémon TCG Scanner
# ==============================================================================

# Application environment
ENVIRONMENT=development

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend / API
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MariaDB Service
MARIADB_IMAGE=mariadb:11.4
MARIADB_DATABASE=tcg
MARIADB_USER=tcg_user
MARIADB_PASSWORD=tcg_password
MARIADB_ROOT_PASSWORD=tcg_root_password

# Database URL for SQLAlchemy (used by API and Alembic inside Docker network)
DATABASE_URL=mysql+pymysql://tcg_user:tcg_password@db:3306/tcg

# TCGdex Provider Configuration
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_HTTP_TIMEOUT=10.0
IMPORT_MAX_RETRIES=3
IMPORT_RETRY_BACKOFF=1.0

# Detail In-Memory Cache Configuration
DETAIL_CACHE_TTL_SECONDS=21600
DETAIL_CACHE_MAX_ENTRIES=500
DETAIL_CACHE_MAX_STALE_SECONDS=86400
DETAIL_CACHE_FAILED_COOLDOWN_SECONDS=60
